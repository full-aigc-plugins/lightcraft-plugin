{
  "name": "lightcraft",
  "version": "0.1.0-dev.20261018.2",
  "description": "RAW develop, landscape and portrait looks, batch grading, tone-curve transfer and virtual-copy review. Edits stay non-destructive.",
  "license": "Apache-2.0",
  "skills": "./skills/",
  "displayName": "LightCraft · Photo Grading",
  "icon": "./assets/official-logo.png",
  "mcpServers": {
    "lightcraft-editor": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${ZCODE_PLUGIN_ROOT}/ui/bootstrap.mjs"
      ],
      "cwd": "${ZCODE_PROJECT_DIR}",
      "env": {
        "CRAFT_PANEL_METADATA_FILE": "${ZCODE_PLUGIN_ROOT}/.zcode-plugin/panel-meta.json",
        "CRAFT_WORKSPACE_ROOT": "${ZCODE_PROJECT_DIR}"
      }
    }
  },
  "displayName_i18n": {
    "en": "LightCraft · Photo Grading"
  },
  "ui": {
    "surfaces": [
      {
        "id": "editor",
        "title": {
          "en-US": "LightCraft · Photo Grading",
          "zh-CN": "LightCraft · 照片调色"
        },
        "icon": "camera",
        "server": "lightcraft-editor",
        "resourceUri": "ui://lightcraft/panel.html",
        "availability": "session"
      }
    ]
  },
  "commands": "commands"
}
