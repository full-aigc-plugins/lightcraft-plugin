{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lightcraft content-bound review v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "requestId",
    "bindingSha256",
    "source",
    "reviewer",
    "verdict",
    "observations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "bindingSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "enum": [
        "human",
        "host-model"
      ]
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
